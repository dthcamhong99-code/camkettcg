{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user-specific settings and profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique identifier for the user." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "photoURL": { "type": "string", "format": "uri", "description": "The user's profile photo URL." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the profile was created." }
      },
      "required": ["uid", "email"]
    },
    "Expert": {
      "title": "Expert",
      "description": "An expert in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID for the expert." },
        "name": { "type": "string", "description": "Full name of the expert." },
        "cccd": { "type": "string", "description": "Citizen identity card number." },
        "certificate": { "type": "string", "description": "Professional certificate details." },
        "ownerId": { "type": "string", "description": "The UID of the user who owns this expert record." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the record was created." }
      },
      "required": ["id", "name", "ownerId"]
    },
    "CommitmentForm": {
      "title": "Commitment Form",
      "description": "Stores the state of the commitment form for a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID." },
        "packageName": { "type": "string", "description": "The name of the package." },
        "decision": { "type": "string", "description": "The decision number." },
        "day": { "type": "string", "description": "Day of commitment." },
        "month": { "type": "string", "description": "Month of commitment." },
        "year": { "type": "string", "description": "Year of commitment." },
        "selectedExpertIds": { "type": "array", "items": { "type": "string" }, "description": "List of selected expert IDs." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update time." }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Private user profile data."
    },
    "/experts/{expertId}": {
      "schema": "Expert",
      "description": "Global or user-specific expert database."
    },
    "/forms/{uid}": {
      "schema": "CommitmentForm",
      "description": "User-specific form state."
    }
  }
}
